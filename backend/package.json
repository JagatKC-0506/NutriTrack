{
  "name": "nutritrack-backend",
  "version": "1.0.0",
  "description": "NutriTrack API Backend - Node.js/Express",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "sequelize-cli db:migrate --url \"$DATABASE_URL\" --migrations-path src/db/migrations",
    "migrate:undo": "sequelize-cli db:migrate:undo --url \"$DATABASE_URL\" --migrations-path src/db/migrations",
    "migrate:status": "sequelize-cli db:migrate:status --url \"$DATABASE_URL\" --migrations-path src/db/migrations",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "nutrition",
    "pregnancy",
    "baby",
    "health"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.2.0",
    "mysql2": "^3.6.5",
    "pg": "^8.22.0",
    "sequelize": "^6.35.2",
    "sqlite3": "^5.1.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.5"
  }
}
